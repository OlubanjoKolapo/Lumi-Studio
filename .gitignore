# Dependencies — reinstalled from package-lock.json
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
next-env.d.ts

# TypeScript incremental cache
*.tsbuildinfo

# Testing
/coverage

# Original photo drop — byte-identical to public/images, which is what the app
# serves. Kept on disk, just not tracked.
/assets/

# Environment — never commit secrets
.env
.env*.local

# Deployment
.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS noise
.DS_Store
Thumbs.db
*.pem
*.swp

# Personal Claude Code settings (shared config belongs in .claude/settings.json)
.claude/settings.local.json
